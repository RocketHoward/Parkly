# Frontend configuration. VITE_* values are public and included in the build.
# Copy this file to .env.local and use values from Supabase Project Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key

# Legacy public anon JWTs are supported instead of a publishable key.
# If using the legacy key, remove the publishable-key line above.
# VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional destination search endpoint (full Photon-compatible /api/ URL).
# Choose an owned or managed service for production use.
# VITE_GEOCODING_URL=https://your-geocoder.example/api/

# NEVER put a service_role key, sb_secret_* key, Google client secret,
# database password, SMTP password, or private AI API key in a VITE_* variable.
# Configure Google OAuth and SMTP secrets in the Supabase dashboard only.
